            { id: 6, name: "Iced Matcha Latte", desc: "Premium matcha green tea with milk and ice.", price: 5.75, category: "Drink", calories: 180, image: "https://images.unsplash.com/photo-1515823064-d6e0c04616a7?auto=format&fit=crop&w=500&q=60" },
            { id: 7, name: "Crispy Fried Chicken", desc: "Golden crispy fried chicken with honey butter dip.", price: 11.50, category: "Main Course", calories: 750, image: "https://images.unsplash.com/photo-1562967914-608f82629710?auto=format&fit=crop&w=500&q=60" },
            { id: 8, name: "Pasta Carbonara", desc: "Creamy pasta with bacon, parmesan, and black pepper.", price: 13.25, category: "Noodles", calories: 680, image: "https://images.unsplash.com/photo-1612874742237-6526221588e3?auto=format&fit=crop&w=500&q=60" },
            { id: 9, name: "Beef Tacos", desc: "Three soft tacos with seasoned beef, salsa, and lime.", price: 10.75, category: "Mexican", calories: 520, image: "https://images.unsplash.com/photo-1551504734-5ee1c4a1479b?auto=format&fit=crop&w=500&q=60" },
            { id: 10, name: "Japanese Ramen", desc: "Rich tonkotsu broth with noodles, egg, and pork slices.", price: 14.00, category: "Noodles", calories: 580, image: "https://images.unsplash.com/photo-1569718212165-3a8278d5f624?auto=format&fit=crop&w=500&q=60" },
            { id: 11, name: "Fluffy Pancakes", desc: "Stack of pancakes with maple syrup, berries, and butter.", price: 8.25, category: "Breakfast", calories: 480, image: "https://images.unsplash.com/photo-1567620905732-2d1ec7ab7445?auto=format&fit=crop&w=500&q=60" },
            { id: 12, name: "Grilled Steak", desc: "Premium ribeye steak with herbs and roasted vegetables.", price: 24.99, category: "Main Course", calories: 650, image: "https://images.unsplash.com/photo-1546833999-b9f581a1996d?auto=format&fit=crop&w=500&q=60" },
            { id: 13, name: "Ice Cream Sundae", desc: "Vanilla ice cream with hot fudge, nuts, and a cherry.", price: 6.50, category: "Dessert", calories: 420, image: "https://images.unsplash.com/photo-1563805042-7684c019e1cb?auto=format&fit=crop&w=500&q=60" },
            { id: 14, name: "Fresh Orange Juice", desc: "Freshly squeezed orange juice, no sugar added.", price: 4.25, category: "Drink", calories: 110, image: "https://images.unsplash.com/photo-1600271886742-f049cd451bba?auto=format&fit=crop&w=500&q=60" }
        ];

        // Safe load: fall back to defaults if saved data is broken
        let items;
        try {
            const saved = JSON.parse(localStorage.getItem('myFood_items_v2'));
            items = (Array.isArray(saved) && saved.length > 0) ? saved : defaultItems;
        } catch (e) {
            items = defaultItems;
        }

        let cart = [];
        let isAdmin = false;
        let activeCategory = 'All';

        // ================= INIT (bind admin button safely) =================
        function initApp() {
            const adminBtn = document.getElementById('adminBtn');
            // Both inline fallback AND addEventListener for maximum reliability
            adminBtn.addEventListener('click', toggleAdminMode);

            renderCategoryFilter();
            renderItems();
            updateCartUI();
            setTimeout(() => adminBtn.classList.remove('attention'), 4000);
        }
        document.addEventListener('DOMContentLoaded', initApp);

        function saveToStorage() {
            try {
                localStorage.setItem('myFood_items_v2', JSON.stringify(items));
            } catch (e) { /* storage full or blocked - app still works in memory */ }
        }

        // ================= ADMIN TOGGLE =================
        function toggleAdminMode() {
            isAdmin = !isAdmin;

            const btn = document.getElementById('adminBtn');
            const icon = document.getElementById('adminIcon');
            const label = document.getElementById('adminLabel');
            const addBtn = document.getElementById('addFoodBtn');
            const banner = document.getElementById('adminBanner');

            if (isAdmin) {
                btn.classList.add('on');
                icon.className = 'fa-solid fa-unlock';
                label.innerText = 'Admin Mode: ON';
                addBtn.style.display = 'inline-flex';
                banner.style.display = 'block';
                showToast('✅ Admin Mode ON — you can edit the menu now!', 'success');
            } else {
                btn.classList.remove('on');
                icon.className = 'fa-solid fa-lock';
                label.innerText = 'Admin Mode: OFF';
                addBtn.style.display = 'none';
                banner.style.display = 'none';
                showToast('Admin Mode OFF', 'neutral');
            }
            renderItems();
        }

        // ================= CATEGORY FILTER =================
        function renderCategoryFilter() {
            const categories = ['All', ...new Set(items.map(i => i.category))];
            const container = document.getElementById('categoryFilter');
            container.innerHTML = categories.map(cat => `
                <button onclick="setCategory('${cat.replace(/'/g, "\\'")}')" class="px-4 py-1.5 rounded-full text-sm font-medium transition-all cursor-pointer ${
                    activeCategory === cat 
                        ? 'bg-orange-500 text-white shadow-md shadow-orange-500/30' 
                        : 'bg-white text-slate-600 border border-slate-200 hover:border-orange-300 hover:text-orange-600'
                }">${cat}</button>
            `).join('');
        }

        function setCategory(cat) {
            activeCategory = cat;
            renderCategoryFilter();
            renderItems();
        }

        // ================= GUIDE =================
        function openGuide() {
            const modal = document.getElementById('guideModal');
            const content = document.getElementById('guideModalContent');
            modal.classList.remove('hidden');
            setTimeout(() => {
                content.classList.remove('scale-95', 'opacity-0');
                content.classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        function closeGuide() {
            const modal = document.getElementById('guideModal');
            const content = document.getElementById('guideModalContent');
            content.classList.remove('scale-100', 'opacity-100');
            content.classList.add('scale-95', 'opacity-0');
            setTimeout(() => modal.classList.add('hidden'), 300);
        }

        function closeGuideAndStart() {
            closeGuide();
            if (!isAdmin) toggleAdminMode();
        }

        function dismissBanner() {
            document.getElementById('adminBanner').style.display = 'none';
        }

        // ================= RENDER MENU =================
        function renderItems() {
            const grid = document.getElementById('foodGrid');
            const emptyState = document.getElementById('emptyState');
            grid.innerHTML = '';

            const filtered = activeCategory === 'All' ? items : items.filter(i => i.category === activeCategory);

            if (filtered.length === 0) {
                emptyState.style.display = 'block';
                return;
            } else {
                emptyState.style.display = 'none';
            }

            filtered.forEach(item => {
                const card = document.createElement('div');
                card.className = 'food-card bg-white rounded-2xl overflow-hidden border shadow-sm flex flex-col h-full ' + (isAdmin ? 'ring-2 ring-orange-300 border-orange-200' : 'border-slate-100');
                
                const adminControls = isAdmin ? `
                    <div class="absolute top-3 right-3 flex gap-2 z-10">
                        <button onclick="editItem(${item.id})" class="bg-blue-500 hover:bg-blue-600 text-white p-2.5 rounded-full shadow-md transition-all cursor-pointer" title="Edit this food">
                            <i class="fa-solid fa-pen text-xs"></i>
                        </button>
                        <button onclick="deleteItem(${item.id})" class="bg-red-500 hover:bg-red-600 text-white p-2.5 rounded-full shadow-md transition-all cursor-pointer" title="Delete this food">
                            <i class="fa-solid fa-trash text-xs"></i>
                        </button>
                    </div>
                ` : '';

                const cal = parseInt(item.calories) || 0;

                card.innerHTML = `
                    <div class="relative h-48 overflow-hidden group">
                        <img src="${item.image}" alt="${item.name}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" onerror="this.src='https://placehold.co/500x300/e2e8f0/94a3b8?text=No+Image'">
                        ${adminControls}
                        <div class="absolute bottom-0 left-0 bg-gradient-to-t from-black/60 to-transparent w-full p-3 pt-8 flex justify-between items-end">
                            <span class="text-xs font-bold text-white bg-orange-500 px-2 py-0.5 rounded uppercase tracking-wider">${item.category}</span>
                            <span class="calorie-badge text-xs font-bold px-2 py-0.5 rounded-full shadow-sm">
                                <i class="fa-solid fa-fire-flame-curved"></i> ${cal} kcal
                            </span>
                        </div>
                    </div>
                    <div class="p-5 flex flex-col flex-1">
                        <div class="flex justify-between items-start mb-2">
                            <h3 class="font-bold text-lg text-slate-800 leading-tight">${item.name}</h3>
                            <span class="font-bold text-orange-600">$${parseFloat(item.price).toFixed(2)}</span>
                        </div>
                        <p class="text-slate-500 text-sm mb-4 line-clamp-2 flex-1">${item.desc}</p>
                        <button onclick="addToCart(${item.id})" class="w-full bg-slate-800 hover:bg-slate-900 text-white py-2 rounded-lg font-medium transition-colors flex items-center justify-center gap-2 group cursor-pointer">
                            <i class="fa-solid fa-plus text-xs group-hover:rotate-90 transition-transform"></i> Add to Order
                        </button>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // ================= ADD / EDIT / DELETE =================
        function openModal(mode, id = null) {
            if (!isAdmin) {
                showToast('Please turn ON Admin Mode first (top right switch)', 'neutral');
                return;
            }
            const modal = document.getElementById('itemModal');
            const overlay = document.getElementById('overlay');
            const content = document.getElementById('modalContent');
            const form = document.getElementById('foodForm');
            
            modal.classList.remove('hidden');
            overlay.classList.remove('hidden');
            
            setTimeout(() => {
                overlay.classList.remove('opacity-0');
                content.classList.remove('scale-95', 'opacity-0');
                content.classList.add('scale-100', 'opacity-100');
            }, 10);

            if (mode === 'edit' && id) {
                const item = items.find(i => i.id === id);
                if (!item) return;
                document.getElementById('modalTitle').innerText = 'Edit Item';
                document.getElementById('itemId').value = item.id;
                document.getElementById('itemName').value = item.name;
                document.getElementById('itemDesc').value = item.desc;
                document.getElementById('itemPrice').value = item.price;
                document.getElementById('itemCalories').value = item.calories || 0;
                document.getElementById('itemCategory').value = item.category;
                document.getElementById('itemImage').value = item.image;
            } else {
                document.getElementById('modalTitle').innerText = 'Add New Item';
                form.reset();
                document.getElementById('itemId').value = '';
            }
        }

        function closeModal() {
            const modal = document.getElementById('itemModal');
            const overlay = document.getElementById('overlay');
            const content = document.getElementById('modalContent');

            overlay.classList.add('opacity-0');
            content.classList.remove('scale-100', 'opacity-100');
            content.classList.add('scale-95', 'opacity-0');

            setTimeout(() => {
                modal.classList.add('hidden');
                overlay.classList.add('hidden');
            }, 300);
        }

        function handleFormSubmit(e) {
            e.preventDefault();
            
            const id = document.getElementById('itemId').value;
            const name = document.getElementById('itemName').value;
            const desc = document.getElementById('itemDesc').value;
            const price = parseFloat(document.getElementById('itemPrice').value);
            const calories = parseInt(document.getElementById('itemCalories').value) || 0;
            const category = document.getElementById('itemCategory').value;
            let image = document.getElementById('itemImage').value;

            if (!image) {
                image = `https://loremflickr.com/500/300/food,${category.toLowerCase()}?lock=${Math.floor(Math.random() * 1000)}`;
            }

            if (id) {
                const index = items.findIndex(i => i.id == id);
                if (index !== -1) {
                    items[index] = { ...items[index], name, desc, price, calories, category, image };
                    showToast('Item updated successfully!', 'success');
                }
            } else {
                items.push({ id: Date.now(), name, desc, price, calories, category, image });
                showToast('New item added to menu!', 'success');
            }

            saveToStorage();
            renderCategoryFilter();
            renderItems();
            closeModal();
        }

        function editItem(id) { openModal('edit', id); }

        function deleteItem(id) {
            if (confirm('Are you sure you want to delete this item?')) {
                items = items.filter(i => i.id !== id);
                saveToStorage();
                renderCategoryFilter();
                renderItems();
                showToast('Item deleted.', 'neutral');
            }
        }

        function generateRandomImage() {
            const categories = ['burger', 'pizza', 'sushi', 'salad', 'dessert', 'drink', 'pasta', 'steak'];
            const randomCat = categories[Math.floor(Math.random() * categories.length)];
            document.getElementById('itemImage').value = `https://loremflickr.com/500/300/${randomCat},food?lock=${Math.floor(Math.random() * 10000)}`;
        }

        // ================= CART =================
        function addToCart(id) {
            const item = items.find(i => i.id === id);
            const existing = cart.find(c => c.id === id);

            if (existing) {
                existing.qty++;
            } else {
                cart.push({ ...item, qty: 1 });
            }
            
            updateCartUI();
            showToast(`${item.name} added to cart`, 'success');
            
            const badge = document.getElementById('cartBadge');
            badge.classList.add('scale-125');
            setTimeout(() => badge.classList.remove('scale-125'), 200);
        }

        function removeFromCart(id) {
            cart = cart.filter(c => c.id !== id);
            updateCartUI();
        }

        function updateQty(id, change) {
            const item = cart.find(c => c.id === id);
            if (item) {
                item.qty += change;
                if (item.qty <= 0) removeFromCart(id);
                else updateCartUI();
            }
        }

        function updateCartUI() {
            const container = document.getElementById('cartItems');
            const badge = document.getElementById('cartBadge');
            const subtotalEl = document.getElementById('cartSubtotal');
            const taxEl = document.getElementById('cartTax');
            const totalEl = document.getElementById('cartTotal');
            const caloriesEl = document.getElementById('cartCalories');

            const totalQty = cart.reduce((sum, item) => sum + item.qty, 0);
            badge.innerText = totalQty;
            if (totalQty > 0) badge.classList.remove('scale-0');
            else badge.classList.add('scale-0');

            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="flex flex-col items-center justify-center h-full text-slate-400">
                        <i class="fa-solid fa-basket-shopping text-5xl mb-4 opacity-20"></i>
                        <p>Your cart is empty</p>
                        <button onclick="toggleCart()" class="mt-4 text-orange-500 font-medium hover:underline cursor-pointer">Browse Menu</button>
                    </div>
                `;
            } else {
                container.innerHTML = cart.map(item => `
                    <div class="flex gap-4 bg-white p-3 rounded-xl border border-slate-100 shadow-sm">
                        <img src="${item.image}" class="w-20 h-20 rounded-lg object-cover bg-slate-100">
                        <div class="flex-1 flex flex-col justify-between">
                            <div>
                                <h4 class="font-bold text-slate-800 text-sm line-clamp-1">${item.name}</h4>
                                <div class="flex items-center gap-2 mt-0.5">
                                    <p class="text-orange-600 font-bold text-sm">$${(item.price * item.qty).toFixed(2)}</p>
                                    <span class="text-xs text-amber-700 bg-amber-50 px-1.5 py-0.5 rounded">
                                        <i class="fa-solid fa-fire-flame-curved text-[9px]"></i> ${(item.calories || 0) * item.qty} kcal
                                    </span>
                                </div>
                            </div>
                            <div class="flex items-center gap-3 mt-2">
                                <button onclick="updateQty(${item.id}, -1)" class="w-6 h-6 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-600 transition-colors cursor-pointer">
                                    <i class="fa-solid fa-minus text-[10px]"></i>
                                </button>
                                <span class="text-sm font-medium w-4 text-center">${item.qty}</span>
                                <button onclick="updateQty(${item.id}, 1)" class="w-6 h-6 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-600 transition-colors cursor-pointer">
                                    <i class="fa-solid fa-plus text-[10px]"></i>
                                </button>
                            </div>
                        </div>
                        <button onclick="removeFromCart(${item.id})" class="text-slate-300 hover:text-red-500 self-start cursor-pointer">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                `).join('');
            }

            const subtotal = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            const tax = subtotal * 0.08;
            const total = subtotal + tax;
            const totalCalories = cart.reduce((sum, item) => sum + ((item.calories || 0) * item.qty), 0);

            subtotalEl.innerText = `$${subtotal.toFixed(2)}`;
            taxEl.innerText = `$${tax.toFixed(2)}`;
            totalEl.innerText = `$${total.toFixed(2)}`;
            caloriesEl.innerText = `${totalCalories} kcal`;
        }

        function toggleCart() {
            const sidebar = document.getElementById('cartSidebar');
            const overlay = document.getElementById('overlay');
            
            if (sidebar.classList.contains('translate-x-full')) {
                sidebar.classList.remove('translate-x-full');
                overlay.classList.remove('hidden');
                setTimeout(() => overlay.classList.remove('opacity-0'), 10);
            } else {
                sidebar.classList.add('translate-x-full');
                overlay.classList.add('opacity-0');
                setTimeout(() => overlay.classList.add('hidden'), 300);
            }
        }

        function closeAllDrawers() {
            const sidebar = document.getElementById('cartSidebar');
            if (!sidebar.classList.contains('translate-x-full')) toggleCart();
            closeModal();
        }

        // ================= CHECKOUT (QR + SMS) =================
        function checkout() {
            if (cart.length === 0) return;
            
            const phone = document.getElementById('phoneNumber').value.trim();
            if (!phone) {
                showToast('Please enter your phone number for SMS notification', 'neutral');
                document.getElementById('phoneNumber').focus();
                return;
            }

            const btn = document.querySelector('#cartSidebar button.bg-slate-800');
            const originalText = btn.innerText;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i>Processing...';
            btn.disabled = true;

            setTimeout(() => {
                const subtotal = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
                const tax = subtotal * 0.08;
                const total = subtotal + tax;
                const totalCalories = cart.reduce((sum, item) => sum + ((item.calories || 0) * item.qty), 0);
                const totalItems = cart.reduce((sum, item) => sum + item.qty, 0);
                const orderNum = Math.floor(100000 + Math.random() * 900000);

                const orderData = {
                    orderId: `MF-${orderNum}`,
                    items: cart.map(i => `${i.name} x${i.qty}`),
                    total: `$${total.toFixed(2)}`,
                    calories: `${totalCalories} kcal`,
                    phone: phone,
                    time: new Date().toLocaleString()
                };

                toggleCart();
                showOrderConfirmation(orderNum, phone, total, totalCalories, totalItems, orderData);

                cart = [];
                updateCartUI();
                btn.innerText = originalText;
                btn.disabled = false;
            }, 1500);
        }

        function showOrderConfirmation(orderNum, phone, total, calories, itemCount, orderData) {
            const modal = document.getElementById('orderModal');
            const content = document.getElementById('orderModalContent');

            document.getElementById('orderNumber').innerText = orderNum;
            document.getElementById('smsPhone').innerText = phone;
            document.getElementById('summaryItems').innerText = `${itemCount} item(s)`;
            document.getElementById('summaryCalories').innerText = `${calories} kcal`;
            document.getElementById('summaryTotal').innerText = `$${total.toFixed(2)}`;

            const qrContainer = document.getElementById('qrcode-container');
            qrContainer.innerHTML = '';

            try {
                new QRCode(qrContainer, {
                    text: JSON.stringify(orderData),
                    width: 180,
                    height: 180,
                    colorDark: "#1e293b",
                    colorLight: "#ffffff",
                    correctLevel: QRCode.CorrectLevel.H
                });
            } catch (e) {
                qrContainer.innerHTML = '<p class="text-xs text-red-500">QR generation failed</p>';
            }

            modal.classList.remove('hidden');
            setTimeout(() => {
                content.classList.remove('scale-95', 'opacity-0');
                content.classList.add('scale-100', 'opacity-100');
            }, 10);

            showToast(`SMS sent to ${phone}`, 'success');
        }

        function closeOrderModal() {
            const modal = document.getElementById('orderModal');
            const content = document.getElementById('orderModalContent');
            content.classList.remove('scale-100', 'opacity-100');
            content.classList.add('scale-95', 'opacity-0');
            setTimeout(() => modal.classList.add('hidden'), 300);
        }

        // ================= TOAST =================
        function showToast(message, type = 'neutral') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            
            let icon = 'fa-info-circle';
            let colorClass = 'bg-slate-800';
            
            if (type === 'success') {
                icon = 'fa-check-circle';
                colorClass = 'bg-green-600';
            }

            toast.className = `toast ${colorClass} text-white px-4 py-3 rounded-lg shadow-lg flex items-center gap-3 min-w-[250px]`;
            toast.innerHTML = `
                <i class="fa-solid ${icon}"></i>
                <span class="font-medium text-sm">${message}</span>
            `;

            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(10px)';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }
    </script>
</body>
</html>
